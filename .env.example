# HoneyGrid Environment Configuration Example
# Copy this file to .env and configure your values

# Discord Webhook for Instant Threat Alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Discord Webhook for Operator Sign-Up Notifications
DISCORD_SIGNUP_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_SIGNUP_WEBHOOK_ID/YOUR_SIGNUP_WEBHOOK_TOKEN

# Server Listener Host and Port
HONEYGRID_HOST=0.0.0.0
HONEYGRID_PORT=8000

# Public / Base URL used when generating Canary links (e.g. http://localhost:8000 or your ngrok/cloud domain)
HONEYGRID_BASE_URL=http://localhost:8000

# Database path
HONEYGRID_DB_PATH=honeygrid.db

# Enable real-time public IP geolocation
ENABLE_GEOIP_LOOKUP=true
